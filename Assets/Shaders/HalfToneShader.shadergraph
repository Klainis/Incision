    },
    "m_Name": "GetMainLight (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -4692.0,
            "y": 174.0,
            "width": 232.0,
